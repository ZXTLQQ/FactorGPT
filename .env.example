# ============================================================
# FactorGPT Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- LLM Configuration (optional - system runs offline by default) ----
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
OPENAI_API_KEY=sk-your-openai-api-key
FACTORGPT_LLM_PROVIDER=deepseek
FACTORGPT_LLM_MODEL=deepseek-chat

# ---- Data Sources (optional) ----
TUSHARE_TOKEN=your-tushare-pro-token

# ---- EastMoney Miaoxiang (MX) API ----
# 东方财富妙想金融数据接口（行情/财务/资讯/选股/自选/组合/社区）。
# 接口文档: https://marketing.dfcfw.com/res/download/A620260623NIYC2U.md
# 申请 API Key 后填入下方（留空则 mx_query.py 会提示未配置）。
# 密钥仅保存在本地 .env，请勿提交到版本库。
MX_APIKEY=
# 可选：覆盖妙想脚本输出目录（默认 <项目根>/output/mx_data/）
# MX_OUTPUT_DIR=

# ---- HuggingFace Mirror (for China mainland users) ----
HF_ENDPOINT=https://hf-mirror.com

# ---- Headline Arena (Forward Testing) ----
# 把因子层的宏观观点（利率/风格/商品方向）转成每日概率预测提交给 Headline Arena，
# 获得与回测相互独立的前瞻（forward）检验线：预测在结果出现前锁定，第三方机械结算。
# 接口文档: https://headlinearena.com/api/v1/agent/onboarding/guide.txt
# 注册 agent（含一次性 client_secret，自动保存 + 人工认领）:
#   python scripts/ha_forward_run.py register --name <bot> --bio "<一句话>" \
#       --model-provider <真实厂商> --model-name <真实模型>
# 凭据也可自动保存到 ~/.headlinearena/credentials.json（两处任一即可）。
HA_AGENT_ID=
HA_CLIENT_SECRET=
# HA_BASE_URL=https://headlinearena.com/api/v1
