# ============================================================
# FactorGPT Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- LLM Configuration (optional - system runs offline by default) ----
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
OPENAI_API_KEY=sk-your-openai-api-key
FACTORGPT_LLM_PROVIDER=deepseek
FACTORGPT_LLM_MODEL=deepseek-chat

# ---- Data Sources (optional) ----
TUSHARE_TOKEN=your-tushare-pro-token

# ---- EastMoney Miaoxiang (MX) API ----
# 东方财富妙想金融数据接口（行情/财务/资讯/选股/自选/组合/社区）。
# 接口文档: https://marketing.dfcfw.com/res/download/A620260623NIYC2U.md
# 申请 API Key 后填入下方（留空则 mx_query.py 会提示未配置）。
# 密钥仅保存在本地 .env，请勿提交到版本库。
MX_APIKEY=
# 可选：覆盖妙想脚本输出目录（默认 <项目根>/output/mx_data/）
# MX_OUTPUT_DIR=

# ---- HuggingFace Mirror (for China mainland users) ----
HF_ENDPOINT=https://hf-mirror.com
