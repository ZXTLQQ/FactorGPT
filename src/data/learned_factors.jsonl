{"title": "ShortTermReversal_Liquidity", "category": "自学习/agent生成", "formula": "", "description": "结合短期反转和流动性指标的混合因子，旨在捕捉市场过度反应后的反弹以及流动性对收益的影响。", "code": "import pandas as pd\nimport numpy as np\ndef alpha_factor(df: pd.DataFrame) -> pd.DataFrame:\n    data = df.copy()\n    ret_col = 'pct_chg'\n    data = data.sort_values(['symbol', 'date']).reset_index(drop=True)\n    data['ret_shift'] = data.groupby('symbol')[ret_col].shift(1)\n\n    def mad_clip(series):\n        median = series.median()\n        mad = (series - median).abs().median()\n        if mad == 0 or pd.isna(mad):\n            return series\n        upper = median + 5 * mad\n        lower = median - 5 * mad\n        return series.clip(lower, upper)\n\n    data['ret_shift_clipped'] = data.groupby('date')['ret_shift'].transform(mad_clip)\n    data['reversal'] = -data['ret_shift_clipped']\n\n    if 'turnover' in data.columns:\n        data['turnover_shift'] = data.groupby('symbol')['turnover'].shift(1)\n        data['avg_turnover_20d'] = data.groupby('symbol')['turnover_shift'].rolling(window=20, min_periods=1).mean().reset_index(level=0, drop=True)\n    else:\n        amt_col = 'amount'\n        data['turnover_approx'] = data[amt_col] / (data['circ_mv'] + 1e-10)\n        data['turnover_shift'] = data.groupby('symbol')['turnover_approx'].shift(1)\n        data['avg_turnover_20d'] = data.groupby('symbol')['turnover_shift'].rolling(window=20, min_periods=1).mean().reset_index(level=0, drop=True)\n\n    # 使用对数变换和正态分布的分位数来计算流动性因子，避免负值和零值问题\n    avg_turnover_20d_log = np.log(data['avg_turnover_20d'] + 1e-10)\n    avg_turnover_20d_log_filled = avg_turnover_20d_log.fillna(0)\n    liquidity = (avg_turnover_20d_log_filled - avg_turnover_20d_log_filled.mean()) / avg_turnover_20d_log_filled.std()\n\n    def rank_zscore(series):\n        rank = series.rank(pct=True).fillna(0)\n        mean = rank.mean()\n        std = rank.std()\n        if std == 0 or pd.isna(std):\n            return pd.Series(0, index=series.index)\n        else:\n            return (rank - mean) / std\n\n    data['reversal_z'] = data.groupby('date')['reversal'].transform(rank_zscore)\n    data['liquidity_z'] = liquidity.transform(rank_zscore)\n\n    data['factor'] = 0.5 * data['reversal_z'] + 0.5 * data['liquidity_z']\n    data['factor'] = data['factor'].fillna(0)\n\n    return data[['date', 'symbol', 'factor']]", "source": "self_learned", "metrics": {"ic": 0.0029816204914016676, "rank_ic": -0.01396535276707771, "icir": 0.014341208144168824, "ic_positive_ratio": 0.5118679050567595, "long_short_return": 0.020919124411519077, "long_short_sharpe": 34.08597074070272, "long_short_cum_return": 504139366.3261164, "max_drawdown": 0.0, "annualized_volatility": 0.15457683049479562, "turnover": 1.330446735395189, "coverage": 1.0, "n_stocks": 63, "n_dates": 970, "quantile_cum": "{0: date\n2020-01-02    0.010611\n2020-01-03    0.004362\n2020-01-06    0.015300\n2020-01-07    0.005234\n2020-01-08    0.014768\n                ...   \n2023-12-25    0.788064\n2023-12-26    0.799653\n2023-12-27    0.809494\n2023-12-28    0.825784\n2023-12-29    0.825784\nName: 0, Length: 970, dtype: float64, 1: date\n2020-01-02    0.011850\n2020-01-03    0.023861\n2020-01-06    0.033083\n2020-01-07    0.028986\n2020-01-08    0.039254\n                ...   \n2023-12-25    0.684969\n2023-12-26    0.704438\n2023-12-27    0.731541\n2023-12-28    0.751918\n2023-12-29    0.751918\nName: 1, Length: 970, dtype: float64, 2: date\n2020-01-02   -0.001562\n2020-01-03    0.008345\n2020-01-06    0.011439\n2020-01-07   -0.007428\n2020-01-08    0.015582\n                ...   \n2023-12-25   -0.198302\n2023-12-26   -0.189457\n2023-12-27   -0.175134\n2023-12-28   -0.162015\n2023-12-29   -0.162015\nName: 2, Length: 970, dtype: float64, 3: date\n2020-01-02    0.008648\n2020-01-03    0.043422\n2020-01-06    0.050709\n2020-01-07    0.039620\n2020-01-08    0.069060\n                ...   \n2023-12-25    0.725249\n2023-12-26    0.709709\n2023-12-27    0.754484\n2023-1